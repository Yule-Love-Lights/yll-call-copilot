# GoHighLevel Private Integration token (same one the AI Quote Tool uses)
HIGHLEVEL_API_KEY=
# GoHighLevel Location ID for Yule Love Lights
HIGHLEVEL_LOCATION_ID=
# Shared secret for POST /api/webhooks/ghl -- GoHighLevel calls that route
# directly (no browser session), authenticating with a `?key=<value>` query
# param checked against this. Generate a long random string (e.g.
# `openssl rand -hex 32`), then set the GHL workflow's webhook action URL to
# https://<this app>/api/webhooks/ghl?key=<the same value>. Without this set,
# every webhook delivery 401s and the dashboard's inbound-call screen-pop
# (src/app/InboundPop.tsx) never fires. A GHL workflow must also be
# configured to actually FIRE this webhook on an inbound conversation message
# (call/SMS/email) -- if no such workflow exists yet, email replies still
# draft via the POST /api/inbox/check fallback poll (the /inbox page's
# "Check inbox now" button), just not instantly.
GHL_WEBHOOK_SECRET=
# Supabase project URL (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key, used to generate cold-call playbooks (Claude)
ANTHROPIC_API_KEY=

# --- Phase 4: live coaching (Twilio + Deepgram) ---
# None of these exist yet -- no Twilio or Deepgram account has been created.
# Every live-coaching code path is env-gated: leave all of the below empty
# and /call/[leadId]/live still works end to end via the built-in simulator
# (real engine, real Claude cards, fake audio). Fill these in once the
# accounts exist to switch that page over to real phone calls.

# Twilio Account SID (starts "AC").
TWILIO_ACCOUNT_SID=
# Twilio API Key SID + Secret (Console -> Account -> API keys & tokens),
# used to mint the browser softphone's Voice access token. Not the Auth
# Token below -- a separate credential pair.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Twilio Auth Token (Console -> Account -> API keys & tokens). Only used to
# validate the X-Twilio-Signature header on inbound webhooks
# (POST /api/twilio/voice) -- signature validation is skipped, not required,
# while this is unset.
TWILIO_AUTH_TOKEN=
# The TwiML App SID whose Voice "request URL" is set to
# https://<this app>/api/twilio/voice.
TWILIO_TWIML_APP_SID=
# The Twilio phone number (E.164, e.g. +15551234567) calls are placed from.
TWILIO_CALLER_ID=

# Deepgram API key, used only by the standalone bridge (scripts/
# live-bridge.mjs), never by the Next.js app itself.
DEEPGRAM_API_KEY=

# Shared secret between this app and scripts/live-bridge.mjs -- the bridge
# has no browser session, so it authenticates its POST /api/live/segment
# calls with this header instead. Any long random string; must match on
# both sides.
LIVE_BRIDGE_SECRET=
# The public wss:// URL Twilio should stream call audio to (the bridge,
# behind a TLS tunnel such as ngrok in front of local port 8787 --
# Twilio Media Streams requires wss://, not ws://). Read by
# POST /api/twilio/voice.
LIVE_BRIDGE_URL=
# Where scripts/live-bridge.mjs should POST transcript segments back to.
# Defaults to http://localhost:3000 (this app's own dev server) if unset;
# only needs to change if the bridge runs against a deployed environment.
LIVE_APP_BASE_URL=

# Master switch for sending follow-up emails/SMS through GoHighLevel. Even
# when true, every send requires a staff click in the app; false/absent
# disables the Send buttons entirely. Also gates POST /api/inbox/[draftId]/send
# (the inbox reply flow, Workstream 6) the same way.
GHL_SEND_ENABLED=

# Lets the optional Vercel cron entry (vercel.json) actually run the weekly
# brain review. Absent/false: the scheduled hit no-ops. The manual button on
# /analytics works regardless.
CRON_ENABLED=

# --- Workstream 6: fast on-brand email replies (Gmail adapter) ---
# None of these exist yet -- no Gmail OAuth app has been created (Naldo's
# decision to make, see the PR body). Until all three are set,
# src/lib/gmail.ts's isGmailConfigured() is false and POST /api/inbox/check
# only ever pulls from GoHighLevel; the source enum and adapter seam already
# exist so filling these in is a pure follow-up, not a shape change.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
