# GoHighLevel Private Integration token (same one the AI Quote Tool uses)
HIGHLEVEL_API_KEY=
# GoHighLevel Location ID for Yule Love Lights
HIGHLEVEL_LOCATION_ID=
# Compatibility secret for a private-workflow POST /api/webhooks/ghl. Current
# HighLevel Marketplace deliveries should use X-GHL-Signature instead. For a
# legacy workflow, prefer the x-ghl-webhook-secret header; the old ?key= query
# remains temporarily supported. Generate an unpadded value of at least 16
# characters (for example `openssl rand -hex 32`).
GHL_WEBHOOK_SECRET=
# Supabase project URL (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Operator-only hosted-migration inputs. Do not set these in Vercel or the
# normal application runtime, and never commit the database URL, password, or
# certificate. The environment and expected ref freeze the selected project.
# SUPABASE_DB_URL must be the guarded direct or session-pooler port-5432 URL;
# checked-in tooling removes its password from the CLI argument and supplies it
# only as PGPASSWORD in a sanitized child environment. The CA path is absolute
# and protected; its digest is independently reviewed lowercase SHA-256.
YLL_MIGRATION_ENVIRONMENT=
YLL_EXPECTED_SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
YLL_SUPABASE_SSL_ROOT_CERT=
YLL_EXPECTED_SUPABASE_SSL_ROOT_CERT_SHA256=
# Credential authority for staff sign-in. Set this explicitly. Production must
# remain `hub`; `quote_tool` is accepted only in a Vercel preview after the
# immutable Quote Tool UUID-to-Hub employee mapping exists in staging. This
# changes authentication only; Hub roles and permissions continue to come from
# the Hub database.
# A non-staging Vercel Preview may leave the complete Hub/Quote auth bundle
# absent. Deployment then reports `mode=unconfigured_preview`, and every
# protected request remains unavailable. Any partial auth bundle still fails
# the deployment preflight.
NEXT_PUBLIC_HUB_AUTH_IDENTITY_SOURCE=hub
# Public Quote Tool Supabase Auth endpoint and publishable/anon key used only
# when the explicit source above is `quote_tool`. Do not put a Quote Tool
# service-role key in these variables or in a browser-exposed environment.
NEXT_PUBLIC_QUOTE_TOOL_AUTH_SUPABASE_URL=
NEXT_PUBLIC_QUOTE_TOOL_AUTH_SUPABASE_ANON_KEY=
# Comma-separated Supabase Auth user UUIDs for Naldo and Jason only. A legacy
# app_users owner/admin row fails closed unless its immutable auth UUID is here.
HUB_OWNER_ADMIN_AUTH_USER_IDS=
# Reserved switch for the merged invite-only Supabase Phone Auth path. Current
# deployment preflight rejects true in every Vercel environment. Decision 25
# keeps this false while invite-only email/password remains active. The paid
# staging database is used for migration and authorization testing; a later
# owner decision must separately resume dedicated phone-login deployment,
# Twilio Verify, Turnstile, recovery, and revocation work.
HUB_PHONE_AUTH_STAGING_ENABLED=false
# Reserved public Cloudflare Turnstile site key for a later phone-auth
# activation. Leave blank while the staging phone-auth switch is false.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Anthropic API key, used to generate cold-call playbooks (Claude)
ANTHROPIC_API_KEY=

# --- Phase 4: live coaching (Twilio + Deepgram) ---
# These variables support preparatory live-call code only. Keep customer calls
# positively disabled until every activation blocker and real-provider smoke
# passes. The customer-call simulator was removed; use Practice for safe
# non-customer coaching instead.

# Twilio Account SID (starts "AC").
TWILIO_ACCOUNT_SID=
LIVE_CUSTOMER_CALLS_ENABLED=false
# Twilio API Key SID + Secret (Console -> Account -> API keys & tokens),
# used to mint the browser softphone's Voice access token. Not the Auth
# Token below -- a separate credential pair.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Twilio Auth Token (Console -> Account -> API keys & tokens). Required to
# validate X-Twilio-Signature on Voice and Whisper webhooks and on the media
# bridge's WebSocket upgrade. Twilio is treated as unconfigured and every
# Twilio entry point fails closed while this is unset.
TWILIO_AUTH_TOKEN=
# The TwiML App SID whose Voice "request URL" is set to
# https://<this app>/api/twilio/voice.
TWILIO_TWIML_APP_SID=
# The Twilio phone number (E.164, e.g. +15551234567) calls are placed from.
TWILIO_CALLER_ID=

# Deepgram API key. Used by the standalone live-coaching bridge (scripts/
# live-bridge.mjs) AND, as of Workstream 1, by the Next.js app itself
# (src/lib/deepgram.ts) to transcribe nightly-synced GHL call recordings.
DEEPGRAM_API_KEY=

# Shared secret between this app and scripts/live-bridge.mjs -- the bridge
# has no browser session, so it authenticates its POST /api/live/segment
# calls with this header instead. Use an unpadded value of at least 16
# characters; it must match on both sides.
LIVE_BRIDGE_SECRET=
# The public wss:// BASE URL Twilio should stream call audio to (the bridge,
# behind a TLS tunnel such as ngrok in front of local port 8787 --
# Twilio Media Streams requires wss://, not ws://). Do not add a query string.
# POST /api/twilio/voice appends a unique, session-bound path; the bridge uses
# this same base URL to validate Twilio's signature on the exact upgrade URL.
LIVE_BRIDGE_URL=
# Where scripts/live-bridge.mjs should POST transcript segments back to.
# Defaults to http://localhost:3000 (this app's own dev server) if unset;
# production must set the Operations Hub's https:// URL. Remote plaintext
# http:// is rejected so bridge credentials and transcripts stay encrypted.
LIVE_APP_BASE_URL=

# Master switch for existing non-follow-up sends through GoHighLevel.
GHL_SEND_ENABLED=false

# Reserved switch for call follow-up email/SMS drafts. Keep false. Phase 0
# preflight rejects true until recipient refresh and uncertain-delivery
# reconciliation are implemented, tested, and approved.
GHL_FOLLOWUP_SEND_ENABLED=false

# Authentication secret for all Vercel Cron requests. Vercel sends this exact
# value as `Authorization: Bearer <value>`. Use an unpadded value of at least
# 16 characters. Missing/invalid credentials are rejected before any job runs.
CRON_SECRET=

# Kill switch for the six optional Vercel cron entries in vercel.json.
# Absent/false: authenticated scheduled hits no-op. Manual Office actions are
# unaffected. This is not caller authentication; CRON_SECRET is required too.
CRON_ENABLED=false

# --- Workstream 1: recordings pipeline (see docs/SALES-EXCELLENCE-PLAN.md
# section 4) ---

# Server-only Supabase credentials for the AI Quote Tool's OWN Supabase
# project (a separate project from this app's). Used for read-only outcome
# labeling and by the local, audited `npm run link:quote-tool-identity` staging
# operator command. Never expose either as a NEXT_PUBLIC variable. Absent:
# outcome labeling falls back to the GHL pipeline stage only.
QUOTE_TOOL_SUPABASE_URL=
QUOTE_TOOL_SUPABASE_SERVICE_ROLE_KEY=
