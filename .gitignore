# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# one-off bootstrap credentials (scripts/create-user.mjs's own output note
# says "change the password and delete this file after first login" — this
# rule is the backstop in case that manual step is missed, so a future
# broad `git add -A`/`git add .` in this actively-pushed repo can never
# stage a live credential)
TEMP-LOGIN*

# vercel
.vercel

# per-machine Claude Code config (launch.json, etc.) -- never committed
/.claude/

# real RingCentral call transcripts (customer/rep conversations) -- never
# committed; scripts/ingest-ringcentral.mjs reads this folder from disk.
# Synthetic fixtures for tests live in fixtures/ringcentral/ instead.
/Transcripts/

# database backups and operator-reviewed migration artifacts must remain in an
# explicitly protected directory outside the repository
*.dump
*.dump.*
*.pgdump
yll-call-copilot-pre-*.contents.txt
/backups/
/migration-artifacts/
operator-reviewed-*.csv
reviewed-metric-artifacts.csv
recording-*-ids.csv
0020-preflight-artifacts-backup*.json
0020-0024-hosted.sql
0020-recording-*-release.sql

# typescript
*.tsbuildinfo
next-env.d.ts
